# AgriSmart AI Environment Configuration
# Application Server
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL Neon / Supabase / Local)
# When not available, the application seamlessly uses high-performance persistent store
DATABASE_URL=postgresql://postgres:password@localhost:5432/agrismart_db

# Google Gemini API Key for Gemini 2.5 Pro & Gemini 2.5 Flash
# You can get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
